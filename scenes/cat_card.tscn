[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/cat_card.gd" id="1_script"]

[node name="CatCard" type="PanelContainer"]
custom_minimum_size = Vector2(330, 510)
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 18

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 9

[node name="Portrait" type="TextureRect" parent="Margin/Rows"]
custom_minimum_size = Vector2(0, 156)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="NameLabel" type="Label" parent="Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Name, age 0"

[node name="PersonalityLabel" type="Label" parent="Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Personality"
autowrap_mode = 3

[node name="TraitsLabel" type="Label" parent="Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Trait, Trait, Trait"
autowrap_mode = 3

[node name="WillingnessLabel" type="Label" parent="Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Willingness 0%"

[node name="WillingnessBar" type="ProgressBar" parent="Margin/Rows"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
show_percentage = false

[node name="Spacer" type="Control" parent="Margin/Rows"]
layout_mode = 2
size_flags_vertical = 3

[node name="SelectButton" type="Button" parent="Margin/Rows"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Select"

[connection signal="pressed" from="Margin/Rows/SelectButton" to="." method="_on_select_button_pressed"]
